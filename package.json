{
  "name": "keymaster",
  "description": "library for defining and dispatching keyboard shortcuts",
  "version": "1.6.3",
  "author": "Thomas Fuchs <thomas@slash7.com> (http://mir.aculo.us)",
  "repository": {
    "type": "git",
    "url": "https://github.com/madrobby/keymaster"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./keymaster.js",
      "default": "./keymaster.js"
    },
    "./shortcut-element": {
      "types": "./keymaster-shortcut.d.ts",
      "import": "./keymaster-shortcut.mjs",
      "default": "./keymaster-shortcut.mjs"
    }
  },
  "browser": "./keymaster.js",
  "main": "./keymaster.js",
  "types": "./index.d.ts",
  "scripts": {
    "test": "node --test"
  },
  "license": "MIT"
}
